#!/bin/bash

# Export all environment variables to /app/.env for consumption by other scripts
# This handles both variables set in Dockerfile and runtime overrides

# Handle dependent variables - set defaults based on other variables if not explicitly provided
: ${DIAGRAM_HOST:=$WIKI_HOST}
: ${DIAGRAM_PORT:=$WIKI_PORT}
: ${DIAGRAM_PROTOCOL:=$WIKI_PROTOCOL}
: ${WIKI_PASSWORDSENDER:=no-reply@$WIKI_HOST}

# WIKI_PROXY - runtime detection if not set
if [ -z "$WIKI_PROXY" ]; then
  WIKI_PROXY=$(getent hosts proxy | awk '{ print $1 ; exit }')
fi

PATH=$PATH:/app/bin

# Write computed variables to /app/.env so entrypoint can source them
{
  echo "DIAGRAM_HOST=$DIAGRAM_HOST"
  echo "DIAGRAM_PORT=$DIAGRAM_PORT"
  echo "DIAGRAM_PROTOCOL=$DIAGRAM_PROTOCOL"
  echo "WIKI_PASSWORDSENDER=$WIKI_PASSWORDSENDER"
  echo "WIKI_PROXY=$WIKI_PROXY"
  echo "PATH=$PATH"
} >> /app/.env
