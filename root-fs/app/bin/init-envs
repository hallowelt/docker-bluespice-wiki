#!/bin/bash

{

	# Antivirus service defaults
	echo "AV_HOST=${AV_HOST:--}"
	echo "AV_PORT=${AV_PORT:-3310}"

	# Backup defaults
	echo "BACKUP_HOUR=${BACKUP_HOUR:-1}"

	# Cache service defaults
	echo "CACHE_HOST=${CACHE_HOST:-cache}"
	echo "CACHE_PORT=${CACHE_PORT:-11211}"

	# Chat defaults
	echo "CHAT_HOST=${CHAT_HOST:-chat}"
	echo "CHAT_PORT=${CHAT_PORT:-3000}"
	echo "CHAT_PROTOCOL=${CHAT_PROTOCOL:-http}"

	# Database defaults
	echo "DB_HOST=${DB_HOST:-database}"
	echo "DB_NAME=${DB_NAME:-bluespice}"
	# DB_PASS is mandatory and has no default value
	echo "DB_PREFIX=${DB_PREFIX:-}"
	echo "DB_ROOT_PASS=${DB_ROOT_PASS:-}"
	echo "DB_ROOT_USER=${DB_ROOT_USER:-}"
	echo "DB_TYPE=${DB_TYPE:-mysql}"
	echo "DB_USER=${DB_USER:-bluespice}"

	# Development/Debug defaults
	echo "DEV_WIKI_DEBUG=${DEV_WIKI_DEBUG:-}"
	echo "DEV_WIKI_DEBUG_LOGCHANNELS=${DEV_WIKI_DEBUG_LOGCHANNELS:-}"

	# Diagram service defaults (depend on WIKI_* vars, set later)
	# Additional ones see below
	echo "DIAGRAM_PATH=${DIAGRAM_PATH:-/_diagram/}"

	# Edition defaults
	echo "EDITION=${EDITION:-}"

	# Formula service defaults
	echo "FORMULA_HOST=${FORMULA_HOST:-formula}"
	echo "FORMULA_PORT=${FORMULA_PORT:-10044}"
	echo "FORMULA_PROTOCOL=${FORMULA_PROTOCOL:-http}"

	# PDF service defaults
	echo "PDF_HOST=${PDF_HOST:-pdf}"
	echo "PDF_PORT=${PDF_PORT:-8080}"
	echo "PDF_PROTOCOL=${PDF_PROTOCOL:-http}"

	# Search service defaults
	echo "SEARCH_HOST=${SEARCH_HOST:-search}"
	echo "SEARCH_PASS=${SEARCH_PASS:-}"
	echo "SEARCH_PORT=${SEARCH_PORT:-9200}"
	echo "SEARCH_PROTOCOL=${SEARCH_PROTOCOL:-http}"
	echo "SEARCH_USER=${SEARCH_USER:-}"

	# SMTP defaults
	echo "SMTP_HOST=${SMTP_HOST:-}"
	echo "SMTP_IDHOST=${SMTP_IDHOST:-}"
	echo "SMTP_PASS=${SMTP_PASS:-}"
	echo "SMTP_PORT=${SMTP_PORT:-25}"
	echo "SMTP_USER=${SMTP_USER:-}"

	# Timezone defaults
	echo "TZ=${TZ:-UTC}"

	# Wiki defaults
	echo "WIKI_BASE_PATH=${WIKI_BASE_PATH:-/}"
	echo "WIKI_EMERGENCYCONTACT=${WIKI_EMERGENCYCONTACT:-}"
	echo "WIKI_FARM_DB_PREFIX=${WIKI_FARM_DB_PREFIX:-sfr_}"
	echo "WIKI_FARM_USE_SHARED_DB=${WIKI_FARM_USE_SHARED_DB:-}"
	echo "WIKI_HOST=${WIKI_HOST:-localhost}"
	echo "WIKI_INITIAL_ADMIN_PASS=${WIKI_INITIAL_ADMIN_PASS:-}"
	echo "WIKI_INITIAL_ADMIN_USER=${WIKI_INITIAL_ADMIN_USER:-Admin}"
	echo "WIKI_LANG=${WIKI_LANG:-en}"
	echo "WIKI_LOG_LEVEL=${WIKI_LOG_LEVEL:-error}"
	echo "WIKI_NAME=${WIKI_NAME:-BlueSpice}"
	echo "WIKI_OAUTH2_PRIVATE_KEY_FILE=${WIKI_OAUTH2_PRIVATE_KEY_FILE:-/data/bluespice/oauth_private.key}"
	echo "WIKI_OAUTH2_PUBLIC_KEY_FILE=${WIKI_OAUTH2_PUBLIC_KEY_FILE:-/data/bluespice/oauth_public.key}"
	echo "WIKI_PORT=${WIKI_PORT:-443}"
	echo "WIKI_POST_INIT_SETTINGS_FILE=${WIKI_POST_INIT_SETTINGS_FILE:-/data/bluespice/post-init-settings.php}"
	echo "WIKI_PRE_INIT_SETTINGS_FILE=${WIKI_PRE_INIT_SETTINGS_FILE:-/data/bluespice/pre-init-settings.php}"
	echo "WIKI_PROTOCOL=${WIKI_PROTOCOL:-https}"
	echo "WIKI_SUBSCRIPTION_KEY=${WIKI_SUBSCRIPTION_KEY:-}"
	echo "WIKI_STATUSCHECK_ALLOWED=${WIKI_STATUSCHECK_ALLOWED:-}"

	# WIKI_PROXY - more sophisticated detection
	echo "WIKI_PROXY=${WIKI_PROXY:-$(getent hosts proxy | awk '{ print $1 ; exit }')}"

	# WIKI_PASSWORDSENDER - depends on WIKI_HOST
	echo "WIKI_PASSWORDSENDER=${WIKI_PASSWORDSENDER:-no-reply@$WIKI_HOST}"

	# Wire defaults
	echo "WIRE_HOST=${WIRE_HOST:-wire}"
	echo "WIRE_PORT=${WIRE_PORT:-3333}"
	echo "WIRE_PROTOCOL=${WIRE_PROTOCOL:-http}"

	# Diagram service defaults that depend on WIKI_* vars
	echo "DIAGRAM_HOST=${DIAGRAM_HOST:-$WIKI_HOST}"
	echo "DIAGRAM_PORT=${DIAGRAM_PORT:-$WIKI_PORT}"
	echo "DIAGRAM_PROTOCOL=${DIAGRAM_PROTOCOL:-$WIKI_PROTOCOL}"

	# Path adjustments
	echo "PATH=$PATH:/app/bin"
} >> /app/.env

# For b/c, in case 5.2 bluespice/helper was not used and file was not migrated therefore
if [ -f /data/.wikienv ]; then
  cat /data/.wikienv >> /app/.env
fi

# Since 5.2
# Load secrets if available; Omit subdirectories and non-uppercase filenames
# if /run/secrets/ exists
if [ -d /run/secrets/ ]; then
  for secret in $(find /run/secrets/ -maxdepth 1 -type f | grep -E '/[A-Z_]+$' | xargs -n1 basename); do
    # For grep:
    # - INTERNAL_CHAT_TOKEN
    # - INTERNAL_SIMPLESAMLPHP_ADMIN_PASS
    # - INTERNAL_SIMPLESAMLPHP_SECRET_SALT
    # - INTERNAL_WIKI_SECRETKEY
    # - INTERNAL_WIKI_UPGRADEKEY
    # - INTERNAL_WIKI_TOKEN_AUTH_SALT
    # - INTERNAL_WIRE_API_KEY
    echo "$secret=$(cat /run/secrets/$secret)" >> /app/.env
  done
fi
