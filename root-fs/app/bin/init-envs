#!/bin/bash

# Antivirus service defaults
echo "AV_HOST=\${AV_HOST:--}" >> /home/bluespice/.bashrc
echo "AV_PORT=\${AV_PORT:-3310}" >> /home/bluespice/.bashrc

# Backup defaults
echo "BACKUP_HOUR=\${BACKUP_HOUR:-1}" >> /home/bluespice/.bashrc

# Cache service defaults
echo "CACHE_HOST=\${CACHE_HOST:-cache}" >> /home/bluespice/.bashrc
echo "CACHE_PORT=\${CACHE_PORT:-11211}" >> /home/bluespice/.bashrc

# Chat defaults
echo "CHAT_HOST=\${CHAT_HOST:-chat}" >> /home/bluespice/.bashrc
echo "CHAT_PORT=\${CHAT_PORT:-3000}" >> /home/bluespice/.bashrc
echo "CHAT_PROTOCOL=\${CHAT_PROTOCOL:-http}" >> /home/bluespice/.bashrc

# Database defaults
echo "DB_HOST=\${DB_HOST:-database}" >> /home/bluespice/.bashrc
echo "DB_NAME=\${DB_NAME:-bluespice}" >> /home/bluespice/.bashrc
# DB_PASS is mandatory and has no default value
echo "DB_PREFIX=\${DB_PREFIX:-}" >> /home/bluespice/.bashrc
echo "DB_ROOT_PASS=\${DB_ROOT_PASS:-}" >> /home/bluespice/.bashrc
echo "DB_ROOT_USER=\${DB_ROOT_USER:-root}" >> /home/bluespice/.bashrc
echo "DB_TYPE=\${DB_TYPE:-mysql}" >> /home/bluespice/.bashrc
echo "DB_USER=\${DB_USER:-bluespice}" >> /home/bluespice/.bashrc

# Development/Debug defaults
echo "DEV_WIKI_DEBUG=\${DEV_WIKI_DEBUG:-}" >> /home/bluespice/.bashrc
echo "DEV_WIKI_DEBUG_LOGCHANNELS=\${DEV_WIKI_DEBUG_LOGCHANNELS:-}" >> /home/bluespice/.bashrc

# Diagram service defaults (depend on WIKI_* vars, set later)
# Additional ones see below
echo "DIAGRAM_PATH=\${DIAGRAM_PATH:-/_diagram/}" >> /home/bluespice/.bashrc

# Edition defaults
echo "EDITION=\${EDITION:-}" >> /home/bluespice/.bashrc

# Formula service defaults
echo "FORMULA_HOST=\${FORMULA_HOST:-formula}" >> /home/bluespice/.bashrc
echo "FORMULA_PORT=\${FORMULA_PORT:-10044}" >> /home/bluespice/.bashrc
echo "FORMULA_PROTOCOL=\${FORMULA_PROTOCOL:-http}" >> /home/bluespice/.bashrc

# PDF service defaults
echo "PDF_HOST=\${PDF_HOST:-pdf}" >> /home/bluespice/.bashrc
echo "PDF_PORT=\${PDF_PORT:-8080}" >> /home/bluespice/.bashrc
echo "PDF_PROTOCOL=\${PDF_PROTOCOL:-http}" >> /home/bluespice/.bashrc

# Search service defaults
echo "SEARCH_HOST=\${SEARCH_HOST:-search}" >> /home/bluespice/.bashrc
echo "SEARCH_PASS=\${SEARCH_PASS:-}" >> /home/bluespice/.bashrc
echo "SEARCH_PORT=\${SEARCH_PORT:-9200}" >> /home/bluespice/.bashrc
echo "SEARCH_PROTOCOL=\${SEARCH_PROTOCOL:-http}" >> /home/bluespice/.bashrc
echo "SEARCH_USER=\${SEARCH_USER:-}" >> /home/bluespice/.bashrc

# SMTP defaults
echo "SMTP_HOST=\${SMTP_HOST:-}" >> /home/bluespice/.bashrc
echo "SMTP_IDHOST=\${SMTP_IDHOST:-}" >> /home/bluespice/.bashrc
echo "SMTP_PASS=\${SMTP_PASS:-}" >> /home/bluespice/.bashrc
echo "SMTP_PORT=\${SMTP_PORT:-25}" >> /home/bluespice/.bashrc
echo "SMTP_USER=\${SMTP_USER:-}" >> /home/bluespice/.bashrc

# Timezone defaults
echo "TZ=\${TZ:-UTC}" >> /home/bluespice/.bashrc

# Wiki defaults
echo "WIKI_BASE_PATH=\${WIKI_BASE_PATH:-/}" >> /home/bluespice/.bashrc
echo "WIKI_EMERGENCYCONTACT=\${WIKI_EMERGENCYCONTACT:-}" >> /home/bluespice/.bashrc
echo "WIKI_FARM_DB_PREFIX=\${WIKI_FARM_DB_PREFIX:-sfr_}" >> /home/bluespice/.bashrc
echo "WIKI_FARM_USE_SHARED_DB=\${WIKI_FARM_USE_SHARED_DB:-}" >> /home/bluespice/.bashrc
echo "WIKI_HOST=\${WIKI_HOST:-localhost}" >> /home/bluespice/.bashrc
echo "WIKI_INITIAL_ADMIN_PASS=\${WIKI_INITIAL_ADMIN_PASS:-}" >> /home/bluespice/.bashrc
echo "WIKI_INITIAL_ADMIN_USER=\${WIKI_INITIAL_ADMIN_USER:-Admin}" >> /home/bluespice/.bashrc
echo "WIKI_LANG=\${WIKI_LANG:-en}" >> /home/bluespice/.bashrc
echo "WIKI_LOG_LEVEL=\${WIKI_LOG_LEVEL:-error}" >> /home/bluespice/.bashrc
echo "WIKI_NAME=\${WIKI_NAME:-BlueSpice}" >> /home/bluespice/.bashrc
echo "WIKI_OAUTH2_PRIVATE_KEY_FILE=\${WIKI_OAUTH2_PRIVATE_KEY_FILE:-/data/bluespice/oauth_private.key}" >> /home/bluespice/.bashrc
echo "WIKI_OAUTH2_PUBLIC_KEY_FILE=\${WIKI_OAUTH2_PUBLIC_KEY_FILE:-/data/bluespice/oauth_public.key}" >> /home/bluespice/.bashrc
echo "WIKI_PORT=\${WIKI_PORT:-443}" >> /home/bluespice/.bashrc
echo "WIKI_POST_INIT_SETTINGS_FILE=\${WIKI_POST_INIT_SETTINGS_FILE:-/data/bluespice/post-init-settings.php}" >> /home/bluespice/.bashrc
echo "WIKI_PRE_INIT_SETTINGS_FILE=\${WIKI_PRE_INIT_SETTINGS_FILE:-/data/bluespice/pre-init-settings.php}" >> /home/bluespice/.bashrc
echo "WIKI_PROTOCOL=\${WIKI_PROTOCOL:-https}" >> /home/bluespice/.bashrc
echo "WIKI_SUBSCRIPTION_KEY=\${WIKI_SUBSCRIPTION_KEY:-}" >> /home/bluespice/.bashrc
echo "WIKI_STATUSCHECK_ALLOWED=\${WIKI_STATUSCHECK_ALLOWED:-}" >> /home/bluespice/.bashrc

# WIKI_PROXY - more sophisticated detection
if [ -z "\$WIKI_PROXY" ]; then
  echo "WIKI_PROXY=\$(getent hosts proxy | awk '{ print \$1 ; exit }')" >> /home/bluespice/.bashrc
fi

# WIKI_PASSWORDSENDER - depends on WIKI_HOST
echo "WIKI_PASSWORDSENDER=\${WIKI_PASSWORDSENDER:-no-reply@\$WIKI_HOST}" >> /home/bluespice/.bashrc

# Wire defaults
echo "WIRE_HOST=\${WIRE_HOST:-wire}" >> /home/bluespice/.bashrc
echo "WIRE_PORT=\${WIRE_PORT:-3333}" >> /home/bluespice/.bashrc
echo "WIRE_PROTOCOL=\${WIRE_PROTOCOL:-http}" >> /home/bluespice/.bashrc

# Diagram service defaults that depend on WIKI_* vars
echo "DIAGRAM_HOST=\${DIAGRAM_HOST:-\$WIKI_HOST}" >> /home/bluespice/.bashrc
echo "DIAGRAM_PORT=\${DIAGRAM_PORT:-\$WIKI_PORT}" >> /home/bluespice/.bashrc
echo "DIAGRAM_PROTOCOL=\${DIAGRAM_PROTOCOL:-\$WIKI_PROTOCOL}" >> /home/bluespice/.bashrc

# Path adjustments
echo "PATH=\$PATH:/app/bin