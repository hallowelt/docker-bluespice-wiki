#!/bin/bash

umask 0002

init-envs
source /app/.env

cat <<EOF
  ____  _            ____        _
 | __ )| |_   _  ___/ ___| _ __ (_) ___ ___
 |  _ \| | | | |/ _ \___ \| '_ \| |/ __/ _ \\
 | |_) | | |_| |  __/___) | |_) | | (_|  __/
 |____/|_|\__,_|\___|____/| .__/|_|\___\___|
                          |_|
EOF
blueSpiceVersion=$(cat "${WIKI_DOCROOT}/w/BLUESPICE-VERSION")
blueSpiceEdition=$(cat "${WIKI_DOCROOT}/w/BLUESPICE-EDITION")
blueSpiceBuildInfo=$(cat "${WIKI_DOCROOT}/w/BUILDINFO")
echo "🚀 BlueSpice $blueSpiceEdition $blueSpiceVersion+$blueSpiceBuildInfo"
echo "---------------------------------------------"
echo ""

substitutePlaceholders /app/bin/config/clamd.conf

exec sh -c "$@"
