#!/bin/bash

# Same condition as `Farm.SharedJobQueue.pre.php`: Let the job runner scan Redis/Valkey only if the wiki uses it as job queue
if [[ "${INTERNAL_ENABLE_FARM:-}" == "true" && "${INTERNAL_ENABLE_FARM_SHARED_JOBQUEUE:-}" == "true" \
	&& -n "${JOBQUEUE_HOST:-}" && "${JOBQUEUE_HOST}" != "-" ]]; then
	export PARALLEL_RUNJOBS_SERVICE_QUEUE=redis
else
	export PARALLEL_RUNJOBS_SERVICE_QUEUE=database
fi

##add Variables to Scripts
substitutePlaceholders /app/bin/config/runJobs_conf.yaml

WIKI_LOG_LEVEL="${WIKI_LOG_LEVEL:-error}"

case "${WIKI_LOG_LEVEL}" in
  debug)
    export WIKI_ERROR_REPORTING="E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED"
    ;;
  warn)
    export WIKI_ERROR_REPORTING="E_ALL & ~E_NOTICE & ~E_USER_NOTICE & ~E_PARSE & ~E_DEPRECATED & ~E_USER_DEPRECATED"
    ;;
  error)
    export WIKI_ERROR_REPORTING="E_ERROR | E_CORE_ERROR | E_COMPILE_ERROR | E_USER_ERROR | E_RECOVERABLE_ERROR"
    ;;
  *)
    export WIKI_ERROR_REPORTING="E_ERROR | E_CORE_ERROR | E_COMPILE_ERROR | E_USER_ERROR | E_RECOVERABLE_ERROR"
    export WIKI_LOG_LEVEL="error"
    ;;
esac

substitutePlaceholders /app/conf/90-bluespice-overrides.ini

echo ""
echo "#############################################"

# Modes
# - `--all` (or `--runAll`): Updates, job runner and process runner. Exactly one instance per stack
# - `--jobrunner`: Only the job runner, waits for the updates of the `--all` instance. Can be scaled horizontally
#   (requires the shared job queue)
# - `--processrunner`: Only the process runner, waits for the updates of the `--all` instance. Must not be scaled
#   horizontally yet, see https://github.com/hallowelt/mwstake-mediawiki-component-processmanager/issues/23
# - `--runJobs` (deprecated): Updates and job runner
# - `--runProcessRunner` (deprecated): Only the process runner
runUpdates=false
waitForUpdates=false
runJobRunner=false
runProcessRunner=false
case "${1:-}" in
	--all|--runAll)
		echo "🏇 Starting TaskRunner"
		runUpdates=true
		runJobRunner=true
		runProcessRunner=true
		;;
	--jobrunner)
		echo "🏇 Starting TaskRunner (job runner only)"
		if [[ "${PARALLEL_RUNJOBS_SERVICE_QUEUE}" != "redis" ]]; then
			echo "⚠️  WARNING: Without the shared job queue, multiple job runners will process the same instances" >&2
		fi
		waitForUpdates=true
		runJobRunner=true
		;;
	--processrunner)
		echo "🏇 Starting TaskRunner (process runner only)"
		echo "⚠️  WARNING: Multiple process runners may execute the same process, see" \
			"https://github.com/hallowelt/mwstake-mediawiki-component-processmanager/issues/23" >&2
		waitForUpdates=true
		runProcessRunner=true
		;;
	--runJobs)
		runUpdates=true
		runJobRunner=true
		;;
	--runProcessRunner)
		runProcessRunner=true
		;;
	*)
		echo "ERROR: Unknown mode '${1:-}', use one of --all, --jobrunner, --processrunner" >&2
		exit 1
		;;
esac

echo "" > /tmp/healthcheck
if [[ "$runUpdates" == "true" ]]; then
	echo "Starting update"
	date > /data/maintenance
	run-updates
	rm /data/maintenance
fi
if [[ "$waitForUpdates" == "true" ]]; then
	# The `--all` instance writes the version after all updates succeeded
	version=$(cat /app/bluespice/w/BLUESPICE-VERSION)
	until [[ "$(cat /data/bluespice/logs/baseversion 2>/dev/null)" == "$version" && ! -f /data/maintenance ]]; do
		echo "Waiting for the updates to version $version"
		sleep 10
	done
fi
if [[ "$runJobRunner" == "true" ]]; then
	echo "Starting runJobs"
	echo "parallel-runJobsService" >> /tmp/healthcheck
	/app/bin/parallel-runJobsService > /proc/1/fd/1 2>&1 &
fi
if [[ "$runProcessRunner" == "true" ]]; then
	echo "Starting ProcessRunner"
	echo "parallel-processRunner" >> /tmp/healthcheck
	/app/bin/parallel-processRunner > /proc/1/fd/1 2>&1 &
fi

echo "ready" > /tmp/state

sleep inf

