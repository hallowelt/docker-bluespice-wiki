#!/bin/bash

# Since ERM46229, we need to add the INTERNAL_SIMPLESAMLPHP_SESSION_API_TOKEN environment variable to the .wikienv / secrets
# Check if the INTERNAL_SIMPLESAMLPHP_SESSION_API_TOKEN is already set in the .wikienv file
if ! grep -q "INTERNAL_SIMPLESAMLPHP_SESSION_API_TOKEN" /data/.wikienv; then
	# If not set, create a new random token and add it to the .wikienv file
	random_token=$(openssl rand -hex 16)
	echo "INTERNAL_SIMPLESAMLPHP_SESSION_API_TOKEN=${random_token}" >> /data/.wikienv
fi